# Copy to .env (local) or set these in Netlify's environment variables.

# URL of the deployed backend (Render/Railway/Fly), no trailing slash.
VITE_SERVER_URL=https://itmajdoor-server.onrender.com

# Optional TURN server for reliable connections across strict NATs / mobile.
# VITE_TURN_URL=turn:your-turn-host:3478
# VITE_TURN_USERNAME=your-username
# VITE_TURN_CREDENTIAL=your-credential
